# =============================================================================
# ClinicNow - environment configuration template.
#
# Copy this file to `.env` (same folder) and fill in real values. `.env` is
# git-ignored and MUST NEVER be committed - see .gitignore and CLAUDE.md Part II
# §C. Every configuration value the app needs lives here (or arrives as a real
# container environment variable via docker-compose.yml) - nothing is hardcoded
# in source and nothing secret lives in appsettings.json.
#
# Values below are written for running everything via `docker-compose up`
# (the primary, required way to run this project). If you run ClinicNow.API or
# ClinicNow.Worker directly on your host machine instead (`dotnet run`, outside
# Docker), see the inline notes for the values you need to change.
# =============================================================================

# --- Database -----------------------------------------------------------------
# DB_SA_PASSWORD is the single source of truth for the SQL Server "sa" account:
# docker-compose.yml uses it both to initialize the clinicnow-sql container AND
# (via variable substitution) to build the API/Worker's connection string, so it
# only ever needs to be set in one place.
DB_SA_PASSWORD=ChangeMe_Str0ng!23
DB_NAME=210082

# Only used when running ClinicNow.API/.Worker directly on your host machine
# (outside docker-compose, where nobody assembles this value for you). Point it
# at your own local SQL Server/LocalDB instance. When running via
# `docker-compose up`, this exact variable is instead composed automatically by
# docker-compose.yml from DB_SA_PASSWORD/DB_NAME above - you don't need to (and
# shouldn't) hand-edit it for that case.
DB_CONNECTION_STRING=Server=localhost,1401;Database=210082;User Id=sa;Password=ChangeMe_Str0ng!23;TrustServerCertificate=True;ConnectRetryCount=0

# --- JWT ------------------------------------------------------------------------
# Generate a real random 32+ character secret per environment - never reuse the
# same key across dev/staging/prod (see CLAUDE.md "Security & Secrets").
JWT_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_ISSUER=ClinicNow
JWT_AUDIENCE=ClinicNow
JWT_EXPIRY_MINUTES=60

# --- RabbitMQ ---------------------------------------------------------------------
# Container-to-container hostname/port (used by API + Worker under docker-compose).
# If you run the API/Worker directly on your host against the Dockerized broker,
# use RABBITMQ_HOST=localhost and the *host-mapped* port from docker-compose.yml
# instead (see the `ports:` section there).
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# --- SMTP (consumed by ClinicNow.Worker only - wired in Phase 5) ----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_ENABLE_SSL=true

# --- PayPal sandbox (consumed by ClinicNow.API only - wired in Phase 8) --------
# Real sandbox credentials, never simulated - rulebook Part II §J.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# --- CORS: explicit allowed origins, comma-separated, never "*" -----------------
# Only browser-based clients are subject to CORS (a real native Windows/Android
# build of either app is not, so this only matters for the dev-only "run the
# Flutter app in a browser" workflow documented in README.md):
#   flutter run -d chrome --web-port=5000   (clinicnow_mobile)
#   flutter run -d chrome --web-port=5001   (clinicnow_desktop)
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5001

# --- API base URL for the Flutter clients ---------------------------------------
# Not read by the API itself - documented here so all configuration stays in one
# place. Pass it at build/run time instead:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:5203/   (Android emulator)
#   flutter run --dart-define=API_BASE_URL=http://localhost:5203/  (Windows desktop, or browser debugging)
API_BASE_URL=http://localhost:5203/
